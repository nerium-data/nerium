# DATABASE_URL is the only required config setting.
# Name the driver in the scheme when it isn't SQLAlchemy's default for the
# dialect; for Postgres that means postgresql+psycopg:// (psycopg v3).
DATABASE_URL=engine://nerium_user@localhost:port/database

# Remainder are optional
# ========
# Path to local directory where Nerium can find query files
QUERY_PATH=/app/query_files
# Path to local directory with marshmallow files, if using custom formats
FORMAT_PATH=/app/format_files
# Set API_KEY to require X-API-Key header from all requests
API_KEY=super-secret-key-value
FLASK_APP=nerium/app.py
FLASK_ENV=development

# For Snowflake keypair auth, supply the private key as a file path *or* as a
# PEM string (literal \n sequences are read as newlines). Set only one; if both
# are set, PRIVATE_KEY_PATH wins. Add PRIVATE_KEY_PASSPHRASE if it's encrypted.
PRIVATE_KEY_PATH=/run/secrets/snowflake_key.p8
# PRIVATE_KEY=
# PRIVATE_KEY_PASSPHRASE=
